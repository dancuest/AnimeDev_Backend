{
  "info": {
    "name": "AnimeDev Backend",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "accessToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health"
      }
    },
    {
      "name": "Top Anime",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/anime/top?limit=10"
      }
    },
    {
      "name": "Search Anime",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/anime/search?q=naruto&limit=10"
      }
    },
    {
      "name": "Anime Detail",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/anime/1"
      }
    },
    {
      "name": "Create Interaction",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"animeId\": 1,\n  \"type\": \"TRIVIA_SCORE\",\n  \"payload\": {\n    \"score\": 8,\n    \"total\": 10\n  }\n}"
        },
        "url": "{{baseUrl}}/interactions"
      }
    },
    {
      "name": "My Interactions",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}",
            "type": "text"
          }
        ],
        "url": "{{baseUrl}}/interactions/me?limit=50"
      }
    }
  ]
}
