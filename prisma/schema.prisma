generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                     String    @id @default(uuid())
  deviceId               String?   @unique
  createdAt              DateTime  @default(now())
  email                  String?   @unique
  password               String?
  displayName            String?
  nickname               String?
  avatarUrl              String?
  coverImageUrl          String?
  passwordResetToken     String?
  passwordResetExpiresAt DateTime?
  updatedAt              DateTime  @updatedAt
  role                   UserRole  @default(USER)

  interactions UserInteraction[]
  settings     UserSettings?

  createdTriviaQuestions  TriviaQuestion[] @relation("CreatedTriviaQuestions")
  reviewedTriviaQuestions TriviaQuestion[] @relation("ReviewedTriviaQuestions")
}

model UserSettings {
  userId             String   @id
  ageRange           Int      @default(0)
  genderCode         Int      @default(0)
  regionCode         Int      @default(0)
  preferredGenres    Int[]    @default([])
  toggles            Json     @default("{}")
  updatedAt          DateTime @updatedAt
  createdAt          DateTime @default(now())
  preferredDurations String[] @default([])

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserInteraction {
  id        String          @id @default(uuid())
  userId    String
  animeId   Int
  type      InteractionType
  payload   Json?
  createdAt DateTime        @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, animeId])
  @@index([userId, type])
}

model TriviaQuestion {
  id                 String               @id @default(uuid())
  animeId            Int
  externalAnimeId    String?
  question           String
  options            Json
  correctAnswerIndex Int
  explanation        String?
  difficulty         TriviaDifficulty
  category           TriviaCategory       @default(GENERAL)
  status             TriviaQuestionStatus @default(PENDING)
  source             TriviaQuestionSource @default(USER_SUBMITTED)

  createdByUserId  String?
  reviewedByUserId String?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  reviewedAt DateTime?

  createdBy  User? @relation("CreatedTriviaQuestions", fields: [createdByUserId], references: [id], onDelete: SetNull)
  reviewedBy User? @relation("ReviewedTriviaQuestions", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([animeId])
  @@index([animeId, status])
  @@index([animeId, status, difficulty])
  @@index([createdByUserId])
  @@index([reviewedByUserId])
  @@index([status])
  @@index([difficulty])
  @@index([category])
}

enum UserRole {
  USER
  MODERATOR
  ADMIN
}

enum InteractionType {
  FAVORITE
  UNFAVORITE
  TRIVIA_SCORE
  VIEW
  DISLIKE
}

enum TriviaDifficulty {
  EASY
  MEDIUM
  HARD
}

enum TriviaCategory {
  CHARACTER
  AUTHOR
  SETTING
  VALUES
  RELIGION
  RACES
  PLOT
  WORLD_BUILDING
  PRODUCTION
  GENERAL
}

enum TriviaQuestionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TriviaQuestionSource {
  OFFICIAL
  USER_SUBMITTED
}

model TriviaQuestionReport {
  id               String   @id @default(cuid())
  questionId       String
  animeId          Int?
  animeTitle       String?
  questionText     String
  reason           String
  status           String   @default("PENDING")
  reporterUserId   String?
  resolvedByUserId String?
  adminNote        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  resolvedAt       DateTime?

  @@index([questionId])
  @@index([animeId])
  @@index([status])
}